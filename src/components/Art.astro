---
// Proste rysunki kreskowe (własne), w stylu grafik z Instagrama.
interface Props { name: 'cat' | 'dog' | 'pair' | 'paw' | 'bowl'; class?: string }
const { name, class: cls = '' } = Astro.props;
---
{name === 'cat' && (
  <svg class={`art ${cls}`} viewBox="0 0 200 200" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M62 170c-10-26-6-58 14-78" />
    <path d="M76 92l-6-30 22 18c10-4 22-4 32 0l22-18-6 30c12 14 12 34 0 46-16 14-46 14-62 0" />
    <circle cx="96" cy="108" r="2.5" fill="currentColor" />
    <circle cx="124" cy="108" r="2.5" fill="currentColor" />
    <path d="M106 120l4 4 4-4M110 124v5" />
    <path d="M86 124l-20-3M86 129l-19 4M134 124l20-3M134 129l19 4" />
    <path d="M78 140c-4 14-2 26 4 32h70c8-10 8-24 0-34" />
    <path d="M152 168c18 2 30-6 32-22" />
  </svg>
)}
{name === 'dog' && (
  <svg class={`art ${cls}`} viewBox="0 0 200 200" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M70 70c-18-6-28 10-26 30 2 14 10 22 18 20" />
    <path d="M130 70c18-6 28 10 26 30-2 14-10 22-18 20" />
    <path d="M70 70c16-12 44-12 60 0 10 10 12 30 8 46-4 18-20 28-38 28s-34-10-38-28c-4-16-2-36 8-46" />
    <circle cx="86" cy="100" r="2.6" fill="currentColor" />
    <circle cx="114" cy="100" r="2.6" fill="currentColor" />
    <path d="M92 118c4-4 12-4 16 0-2 6-14 6-16 0z" fill="currentColor" />
    <path d="M100 124v8M92 134c4 4 12 4 16 0" />
    <path d="M76 140c-8 10-10 22-8 32M124 140c8 10 10 22 8 32" />
  </svg>
)}
{name === 'pair' && (
  <svg class={`art ${cls}`} viewBox="0 0 320 220" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M180 60c-14-8-24 6-22 24 1 12 8 18 14 17" />
    <path d="M240 60c14-8 24 6 22 24-1 12-8 18-14 17" />
    <path d="M180 60c14-10 46-10 60 0 9 9 10 26 6 40-4 16-17 24-36 24s-32-8-36-24c-4-14-3-31 6-40" />
    <circle cx="196" cy="86" r="2.5" fill="currentColor" /><circle cx="224" cy="86" r="2.5" fill="currentColor" />
    <path d="M203 102c4-3 10-3 14 0-2 5-12 5-14 0z" fill="currentColor" />
    <path d="M182 120c-10 18-14 50-10 80h82c6-30 2-62-10-80" />
    <path d="M66 200c-8-22-4-48 10-64" />
    <path d="M78 138l-5-24 18 14c8-3 18-3 26 0l18-14-5 24c10 12 10 28 0 38-13 12-38 12-52 0" />
    <circle cx="94" cy="150" r="2.2" fill="currentColor" /><circle cx="116" cy="150" r="2.2" fill="currentColor" />
    <path d="M102 160l3 3 3-3" />
    <path d="M80 176c-3 10-2 18 2 24h56c4-8 4-16 0-24" />
    <path d="M140 196c14 2 22-6 22-16" />
  </svg>
)}
{name === 'paw' && (
  <svg class={`art ${cls}`} viewBox="0 0 40 40" aria-hidden="true" fill="currentColor">
    <ellipse cx="20" cy="26" rx="8" ry="7" />
    <ellipse cx="9" cy="16" rx="3.6" ry="4.6" />
    <ellipse cx="16" cy="9" rx="3.6" ry="4.8" />
    <ellipse cx="24" cy="9" rx="3.6" ry="4.8" />
    <ellipse cx="31" cy="16" rx="3.6" ry="4.6" />
  </svg>
)}
{name === 'bowl' && (
  <svg class={`art ${cls}`} viewBox="0 0 120 80" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14 40h92c-2 18-18 30-46 30S16 58 14 40z" />
    <path d="M30 40c2-10 10-16 18-14M52 40c0-10 8-18 18-16M74 40c2-8 10-12 16-10" />
  </svg>
)}
